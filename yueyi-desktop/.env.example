# ===== 小布记忆 · Desktop 环境变量示例 =====
# 复制本文件为 .env（切勿提交 .env 到 Git）
# 说明：应用会优先读取 SQLite settings 表中的配置；
# 若 settings 中 api_key 为空，则回退读取下方环境变量。

# DeepSeek API Key（也可在应用「设置 → AI」中填写）
DEEPSEEK_API_KEY=

# API Base URL（默认 DeepSeek 官方，兼容 OpenAI 协议）
# 注意：Endpoint 会自动拼接为 {BASE}/v1/chat/completions
# 若你的 BASE 已包含 /v1，则不再重复拼接
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称
DEEPSEEK_MODEL=deepseek-chat

# ===== 数据目录（可选）=====
# 默认：%USERPROFILE%\YueyiData
# YUEYI_DATA_DIR=D:\YueyiData

# ===== 开发用（可选）=====
# VITE_DEV_HOST=127.0.0.1
